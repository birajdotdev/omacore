#!/usr/bin/env bash
# Installs a pinned, hash-verified OpenSCQ30 CLI release into ~/.local.
#
# Two ways to run it:
#   * "Install OpenSCQ30 CLI" button in the panel -> opens this in a floating
#     terminal with clickable Yes/No confirmation and visible download output.
#   * Installation is only started from the explicit panel action, so the
#     third-party binary is never downloaded without the user's consent.
set -euo pipefail

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/omacore-env"

OPENSCQ30_VERSION="v2.12.0"
OPENSCQ30_GH="Oppzippy/OpenSCQ30"
BIN_DIR="$HOME/.local/opt/openscq30"
BIN_LINK="$HOME/.local/bin/openscq30"
MAX_DOWNLOAD_BYTES=52428800

command_exists() { command -v "$1" >/dev/null 2>&1; }

say()  { printf '\033[1;32m==>\033[0m %s\n' "$1"; }
info() { printf '\033[1;34m i\033[0m %s\n' "$1"; }
die()  { printf '\033[1;31mERROR\033[0m %s\n' "$1" >&2; exit 1; }

if [ -n "$OMACORE_CTL" ] && "$OMACORE_CTL" list-models 2>/dev/null | grep -q "SoundcoreD1202"; then
  info "openscq30 already installed and recent: $("$OMACORE_CTL" --version 2>/dev/null | head -1)"
  info "Nothing to do."
  read -rp "Press Enter to close this window." _
  exit 0
fi

command_exists curl || die "curl is required to download OpenSCQ30."
command_exists gum || die "gum is required for the Yes/No confirmation."

case "$(uname -m)" in
  x86_64) arch="x86_64" ;;
  aarch64|arm64) arch="arm64" ;;
  *) die "Unsupported architecture: $(uname -m) (OpenSCQ30 ships amd64/arm64 linux builds)" ;;
esac
asset="openscq30-cli-linux-$arch"
case "$arch" in
  x86_64) expected_sha256="97654c9dcadc320302529641e31536e3324a3eb8abb3bd2dd21bff5263ca3d08" ;;
  arm64) expected_sha256="aeacdc17b5db6a67ec5a29775dde3d1ad8730d2f905404a27b57aecddc5f7814" ;;
esac
url="https://github.com/$OPENSCQ30_GH/releases/download/$OPENSCQ30_VERSION/$asset"

printf 'This will download and run OpenSCQ30 %s from the official GitHub release into %s.\n' \
  "$OPENSCQ30_VERSION" "$BIN_DIR"
if ! gum confirm \
  "Install OpenSCQ30 $OPENSCQ30_VERSION?" \
  --affirmative="Yes" \
  --negative="No" \
  --show-output
then
  die "Installation cancelled."
fi

mkdir -p "$BIN_DIR" "$HOME/.local/bin"
tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/omacore-install.XXXXXX")"
trap 'rm -rf "$tmp_dir"' EXIT
tmp_file="$tmp_dir/$asset"
say "Downloading $url"
curl --fail --location --silent --show-error \
  --connect-timeout 10 --max-time 120 --max-filesize "$MAX_DOWNLOAD_BYTES" \
  -o "$tmp_file" "$url"
actual_size="$(wc -c < "$tmp_file")"
(( actual_size > 0 && actual_size <= MAX_DOWNLOAD_BYTES )) \
  || die "Downloaded file exceeds the ${MAX_DOWNLOAD_BYTES}-byte limit."
actual_sha256="$(sha256sum "$tmp_file" | awk '{print $1}')"
[[ "$actual_sha256" == "$expected_sha256" ]] \
  || die "SHA-256 mismatch for $asset; refusing to install."

verified_file="$BIN_DIR/$asset-$OPENSCQ30_VERSION"
install -m 0755 "$tmp_file" "$verified_file"
ln -sfn "$verified_file" "$BIN_LINK"
info "Installed verified $OPENSCQ30_VERSION: $BIN_LINK -> $verified_file"

echo
echo "Next: register your earbuds, then pair them over Bluetooth."
echo "  openscq30 paired-devices add -a <mac-address> -m <model>"
echo "To find the MAC and model of connected buds:"
echo "  bluetoothctl devices Connected"
echo "  openscq30 list-models"
echo
read -rp "Press Enter to close this window." _