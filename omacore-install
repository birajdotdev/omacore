#!/usr/bin/env bash
# Installs the OpenSCQ30 CLI (official latest release) into ~/.local, no sudo
# needed.
#
# Two ways to run it:
#   * "Install OpenSCQ30 CLI" button in the panel -> opens this in a visible
#     terminal (omarchy-launch-terminal) so you can watch the download.
#   * The widget itself runs `omacore-install --silent` in the background the
#     first time it notices the CLI is missing, so a fresh install self-heals
#     without any interaction.
set -euo pipefail

SILENT=0
[[ "${1:-}" == "--silent" ]] && SILENT=1

OPENSCQ30_GH="Oppzippy/OpenSCQ30"
BIN_DIR="$HOME/.local/opt/openscq30"
BIN_LINK="$HOME/.local/bin/openscq30"

command_exists() { command -v "$1" >/dev/null 2>&1; }

say()  { (( SILENT )) || printf '\033[1;32m==>\033[0m %s\n' "$1"; }
info() { (( SILENT )) || printf '\033[1;34m i\033[0m %s\n' "$1"; }
die()  { printf '\033[1;31mERROR\033[0m %s\n' "$1" >&2; exit 1; }

latest_release() {
  if command_exists gh; then
    gh release view --repo "$OPENSCQ30_GH" --json tagName --jq .tagName
  else
    curl -fsSL "https://api.github.com/repos/$OPENSCQ30_GH/releases/latest" \
      | grep -o '"tag_name":[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"\(.*\)"/\1/'
  fi
}

if command_exists openscq30 && openscq30 list-models 2>/dev/null | grep -q "SoundcoreD1202"; then
  info "openscq30 already installed and recent: $(openscq30 --version 2>/dev/null | head -1)"
  info "Nothing to do."
  (( SILENT )) || read -rp "Press Enter to close this window." _
  exit 0
fi

command_exists curl || die "curl is required to download OpenSCQ30."

tag="$(latest_release)" || true
[[ -n "$tag" ]] || die "Could not determine the latest OpenSCQ30 release."

case "$(uname -m)" in
  x86_64) arch="x86_64" ;;
  aarch64|arm64) arch="arm64" ;;
  *) die "Unsupported architecture: $(uname -m) (OpenSCQ30 ships amd64/arm64 linux builds)" ;;
esac
asset="openscq30-cli-linux-$arch"
url="https://$OPENSCQ30_GH/releases/download/$tag/$asset"

mkdir -p "$BIN_DIR" "$HOME/.local/bin"
say "Downloading $OPENSCQ30_GH/releases/download/$tag/$asset"
if command_exists gh; then
  gh release download "$tag" --repo "$OPENSCQ30_GH" --pattern "$asset" --dir "$BIN_DIR"
else
  # --progress-bar fights a non-tty stdout (the widget's background run) with
  # carriage-return spam; keep it only for the visible-terminal path.
  if (( SILENT )); then
    curl -fsSL -o "$BIN_DIR/$asset" "$url"
  else
    curl -fSL --progress-bar -o "$BIN_DIR/$asset" "$url"
  fi
fi
chmod +x "$BIN_DIR/$asset"
ln -sf "$BIN_DIR/$asset" "$BIN_LINK"
info "Installed: $BIN_LINK -> $BIN_DIR/$asset"

(( SILENT )) && exit 0

echo
echo "Next: register your earbuds, then pair them over Bluetooth."
echo "  openscq30 paired-devices add -a <mac-address> -m <model>"
echo "To find the MAC and model of connected buds:"
echo "  bluetoothctl devices Connected"
echo "  openscq30 list-models"
echo
read -rp "Press Enter to close this window." _