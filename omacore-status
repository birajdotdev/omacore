#!/usr/bin/env bash
# Auto-discovers which paired Soundcore device is currently connected over
# Bluetooth, fetches its settings schema via list-settings, then reads the
# current values of every relevant setting.  Emits one JSON blob:
#
#   { connected, mac, name, model, devices: [{mac, name, model}],
#     schema: [ { categoryId, settings: [ { settingId, type, options?, ... } ] } ],
#     values: { settingId: value, ... } }
#
# No user configuration required — just Bluetooth pairing + OpenSCQ30 registration.
set -uo pipefail

device_match=""
if [ "${1:-}" = "--device-match" ]; then
  device_match="${2:-}"
fi
device_match="${device_match,,}"

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/omacore-env"

if [ -z "$OMACORE_CTL" ]; then
  echo '{"connected":false,"cliMissing":true,"error":"openscq30 / openscq30-cli not found on PATH"}'
  exit 0
fi

read_error() {
  jq -n --arg error "$1" '{connected:false, readError:true, error:$error}'
  exit 0
}

paired_json=$("$OMACORE_CTL" paired-devices list --json 2>/dev/null) || read_error "Could not read the OpenSCQ30 device registry."
jq -e 'type == "array"' <<<"$paired_json" >/dev/null 2>&1 || read_error "Invalid device registry response."

connected_raw=$(bluetoothctl devices Connected 2>/dev/null) || read_error "Could not check Bluetooth connections."

mac=""
name=""
model=""
available_devices='[]'

while IFS= read -r line; do
  [ -z "$line" ] && continue
  cmac=$(awk '{print $2}' <<<"$line")
  cname=$(cut -d' ' -f3- <<<"$line")
  m=$(jq -r --arg mac "$cmac" '.[] | select(.macAddress | ascii_upcase == ($mac | ascii_upcase)) | .model' <<<"$paired_json" 2>/dev/null)
  if [ -n "$m" ] && [ "$m" != "null" ]; then
    available_devices=$(jq -c --arg mac "$cmac" --arg name "$cname" --arg model "$m" \
      '. + [{mac:$mac, name:$name, model:$model}]' <<<"$available_devices")
    if [ -z "$mac" ] && { [ -z "$device_match" ] || [[ "${cmac,,}" == *"$device_match"* || "${cname,,}" == *"$device_match"* ]]; }; then
      mac="$cmac"
      name="$cname"
      model="$m"
    fi
  fi
done <<<"$connected_raw"

if [ -z "$mac" ]; then
  # No *registered* Soundcore device is connected. Before giving the generic
  # "nothing connected", check whether something is paired over Bluetooth and
  # connected but simply not registered with OpenSCQ30 yet — that's a distinct,
  # fixable situation worth saying so instead of silently pretending nothing
  # is there. Non-Soundcore devices (mice, phones, ...) don't qualify.
  if [ -z "$connected_raw" ]; then
    jq -cn --argjson devices "$available_devices" '{connected:false, devices:$devices}'
    exit 0
  fi
  models_json=$($OMACORE_CTL list-models --json 2>/dev/null)
  [ -n "$models_json" ] || models_json='[]'

  candidate=""
  candidate_name=""

  while IFS= read -r line; do
    [ -z "$line" ] && continue
    cmac=$(awk '{print $2}' <<<"$line")
    cname=$(cut -d' ' -f3- <<<"$line")
    if [ -n "$device_match" ] && [[ "${cmac,,}" != *"$device_match"* && "${cname,,}" != *"$device_match"* ]]; then continue; fi
    if [ -z "$cmac" ] || [ -z "$cname" ]; then continue; fi
    in_registry=$(jq -r --arg mac "$cmac" '[.[] | select(.macAddress | ascii_upcase == ($mac | ascii_upcase))] | length' <<<"$paired_json" 2>/dev/null)
    [ "$in_registry" = "1" ] && continue
    looks_soundcore=$(jq -r --arg name "${cname,,}" '
      ( [ .[].name | ascii_downcase ] + [ .[].model | ascii_downcase ] ) as $terms
      | ([ $terms[] as $term | select(( $name | index($term) ) != null) ] | length > 0)
        or ($name | contains("soundcore"))
    ' <<<"$models_json" 2>/dev/null)
    if [ "$looks_soundcore" = "true" ]; then
      candidate="$cmac"
      candidate_name="$cname"
      break
    fi
  done <<<"$connected_raw"

  if [ -n "$candidate" ]; then
    suggested_model=$(jq -r --arg name "$candidate_name" \
      '[.[] | select(.name | ascii_downcase == ($name | ascii_downcase)) | .model]
       | if length == 1 then .[0] else "" end' <<<"$models_json" 2>/dev/null)
    jq -n \
      --arg mac "$candidate" \
      --arg name "$candidate_name" \
      --arg suggested "$suggested_model" \
      --argjson models "$models_json" \
      --argjson devices "$available_devices" \
      '{connected:false, registeredMissing:true, unregisteredMac:$mac, unregisteredName:$name,
        suggestedModel:($suggested | if . == "" then null else . end), models:$models, devices:$devices}'
    exit 0
  fi

  jq -cn --argjson devices "$available_devices" --arg preferred "$device_match" \
    '{connected:false, devices:$devices, preferredMissing:($preferred != "" and ($devices | length) > 0)}'
  exit 0
fi

schema_json=$("$OMACORE_CTL" device --mac-address "$mac" list-settings --json 2>/dev/null) || read_error "Bluetooth is connected, but the earbud settings could not be read."
jq -e 'type == "array" and length > 0' <<<"$schema_json" >/dev/null 2>&1 || read_error "No settings returned by the earbuds."

filtered_schema=$(jq '[.[] | select(.categoryId=="soundModes" or .categoryId=="equalizer" or .categoryId=="equalizerImportExport" or .categoryId=="deviceInformation" or .categoryId=="miscellaneous" or .categoryId=="dualConnections" or .categoryId=="buttonConfiguration" or .categoryId=="limitHighVolume")]' <<<"$schema_json")

ids=$(jq -r '
  [.[] | select(.categoryId=="soundModes" or .categoryId=="equalizer" or .categoryId=="deviceInformation" or .categoryId=="miscellaneous" or .categoryId=="dualConnections" or .categoryId=="buttonConfiguration" or .categoryId=="limitHighVolume")
       | .settings[] | select(.type=="select" or .type=="optionalSelect" or .type=="toggle"
                                or .type=="equalizer" or .type=="information" or .type=="i32Range" or .type=="modifiableSelect"
                                or .type=="multiSelectWithRemove")
       | .settingId]
  | unique | .[]
' <<<"$schema_json" 2>/dev/null)

get_args=()
while IFS= read -r id; do
  [ -z "$id" ] && continue
  get_args+=(--get "$id")
done <<<"$ids"

values_json='[]'
if [ "${#get_args[@]}" -gt 0 ]; then
  values_json=$("$OMACORE_CTL" device --mac-address "$mac" setting "${get_args[@]}" --json 2>/dev/null) || read_error "Bluetooth is connected, but the earbud status could not be read."
  jq -e 'type == "array" and length > 0 and all(.[]; has("settingId") and (.value | type == "object" and has("value")))' <<<"$values_json" >/dev/null 2>&1 || read_error "Invalid earbud status response."
fi

values_map=$(jq '[.[] | {(.settingId): .value.value}] | add // {}' <<<"$values_json")

jq -n \
  --arg mac "$mac" \
  --arg name "$name" \
  --arg model "$model" \
  --argjson devices "$available_devices" \
  --argjson schema "$filtered_schema" \
  --argjson values "$values_map" \
  '{connected:true, mac:$mac, name:$name, model:$model, devices:$devices, schema:$schema, values:$values}'
